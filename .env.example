# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Use somente a chave publicável; nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave
# Endereço público da página institucional (opcional). Com ele, Configurações abre a Política de
# Privacidade e os Termos de Uso; sem ele, esses dois itens ficam ocultos.
EXPO_PUBLIC_SITE_URL=
# Web: 1 abre o app completo no `npm run web` (em vez da apresentação institucional).
# O `npm run build:web` ignora este valor e exporta os dois (apresentação em / e app em /app).
EXPO_PUBLIC_WEB_APP=

# Mapbox: somente token público pk. Nunca coloque token sk no aplicativo.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
